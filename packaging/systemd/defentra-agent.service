[Unit]
Description=Defentra DAS managed agent
Documentation=https://github.com/jacobtblalock3-cmd/defentra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/defentra/bin/defentra agent run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
