[Unit]
Description=Defentra DAS management console
Documentation=https://github.com/jacobtblalock3-cmd/defentra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=defentra-admin
Group=defentra-admin
Environment=DEFENTRA_HOME=/var/lib/defentra-console
ExecStart=/opt/defentra/bin/defentra admin serve --host 0.0.0.0 --port 8477 \
    --tls-cert /etc/defentra/tls/server.crt --tls-key /etc/defentra/tls/server.key
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/defentra-console
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
