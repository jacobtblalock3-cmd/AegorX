[Unit]
Description=Defentra signature feed update
Documentation=https://github.com/jacobtblalock3-cmd/defentra
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/defentra/bin/defentra feed update
# non-fatal exit when the feed is unchanged since last apply
SuccessExitStatus=0
